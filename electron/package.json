{
  "name": "flowa-desktop",
  "productName": "FLOWA",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo FLOWA para Windows conectado ao site oficial",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test policy.test.cjs main.test.cjs",
    "package:windows": "electron-packager . FLOWA --platform=win32 --arch=x64 --out=release --overwrite --icon=icon.ico --ignore=^/release --ignore=\\.test\\.cjs$ --ignore=^/bun\\.lock$"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}